APP_NAME=InsuraLab
KNOWLEDGE_AI_ENABLED=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Public URL of the Next.js frontend (used for CORS + Sanctum).
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated list of origins allowed to call the API (overrides
# FRONTEND_URL for CORS). Never use "*" in a deployed environment.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://insuralab.example

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL ---------------------------------------------------
# Local dev reuses an existing PostgreSQL 18 Docker container on host port 5433.
# `docker compose --profile full up` instead exposes a self-contained service.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=insuralab
DB_USERNAME=insuralab
DB_PASSWORD=insuralab

# Separate database used by the test suite (see phpunit.xml).
DB_TEST_DATABASE=insuralab_testing

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- Sanctum / session auth for the Filament admin panel ------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@insuralab.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- First admin user, created by `php artisan db:seed` -------------------
ADMIN_NAME="InsuraLab Admin"
ADMIN_EMAIL=admin@insuralab.test
ADMIN_PASSWORD=password
